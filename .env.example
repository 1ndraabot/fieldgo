# Supabase = hanya host PostgreSQL (BUKAN supabase-js / PostgREST, dilarang oleh tech requirements).
# Dashboard Supabase → Project Settings → Database → Connection string.
# Pooler (Transaction, port 6543) untuk runtime aplikasi:
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Koneksi langsung (port 5432) untuk migrasi Prisma:
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# Awalan URL publik bucket foto lapangan (Supabase Storage bucket publik atau S3/R2/MinIO), tanpa slash akhir:
STORAGE_PUBLIC_BASE_URL="https://<ref>.supabase.co/storage/v1/object/public/foto-lapangan"

# URL publik aplikasi, dipakai untuk tautan verifikasi email dan redirect gateway:
APP_URL="http://localhost:3000"

# Payment gateway. "fake" = simulasi lokal (hanya non-production), "xendit" = Xendit Invoice.
# Kredensial HANYA di environment; jangan pernah disimpan di basis data atau dikirim ke klien.
GATEWAY_PROVIDER="fake"
# Secret key Xendit (test/production). Jangan beri awalan NEXT_PUBLIC_.
XENDIT_SECRET_KEY=""
# Callback token dari dashboard Xendit (Settings → Callbacks). Diverifikasi pada
# setiap notifikasi lewat header x-callback-token.
XENDIT_CALLBACK_TOKEN=""
# Saklar demo (opsional): "true" mengizinkan tombol simulasi pembayaran test-mode Xendit
# tampil di production (Vercel). Nyalakan hanya saat demo, matikan setelahnya — selama
# aktif, siapa pun yang login bisa mengonfirmasi pesanan tanpa bayar. Kunci tetap wajib
# kunci test (xnd_development_); dengan kunci live simulasi otomatis mati.
GATEWAY_SIMULASI_TEST=""

# Mailer: "gmail" | "resend" | kosong (auto: gmail → resend → konsol).
MAILER=""

# Gmail SMTP (pilihan aktif saat ini): kirim email verifikasi/reset sandi dari akun Gmail sendiri
# ke pendaftar mana pun (batas ±500 email/hari). Prasyarat: 2FA akun aktif, lalu buat App Password
# di myaccount.google.com → Security → App passwords (password 16 huruf).
SMTP_GMAIL_USER="akun@gmail.com"
SMTP_GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
MAIL_DARI_NAMA="FieldGo"

# Resend (alternatif): kunci API dari dashboard Resend + alamat pengirim.
# Testing: MAIL_DARI="onboarding@resend.dev" (hanya kirim ke email akun Resend sendiri).
# Produksi: verifikasi domain sendiri di dashboard Resend, lalu "FieldGo <noreply@domain-anda.id>".
# Kosongkan keduanya untuk fallback mailer konsol (dev saja).
RESEND_API_KEY=""
MAIL_DARI=""

# Storage bukti transfer (bucket PRIVAT). Kosongkan untuk pengembangan: berkas disimpan ke ./.data (dummy).
# Dipakai server-side saja; JANGAN beri awalan NEXT_PUBLIC_.
SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
BUKTI_BUCKET="bukti-pembayaran"
