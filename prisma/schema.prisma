// Subset PRD Bagian 7 yang dibaca Beranda. Entitas lain (Fasilitas, Pembayaran, TokenAkun, dst.) menyusul.
// Constraint yang tidak bisa ditulis di Prisma (CHECK jam 6-24, UNIQUE parsial SlotPesanan aktif) masuk lewat SQL migrasi.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TipeHari {
  weekday
  weekend

  @@map("tipe_hari")
}

enum PeranPengguna {
  penyewa
  admin

  @@map("peran_pengguna")
}

enum JenisToken {
  verifikasi_email
  reset_sandi

  @@map("jenis_token")
}

enum StatusVerifikasi {
  menunggu
  disetujui
  ditolak

  @@map("status_verifikasi")
}

enum StatusPengajuan {
  menunggu
  disetujui
  ditolak

  @@map("status_pengajuan")
}

enum StatusPembayaranGateway {
  pending
  dibayar
  gagal
  kedaluwarsa
  refund
  sebagian_refund
  perlu_tinjau

  @@map("status_pembayaran_gateway")
}

enum StatusRefund {
  menunggu
  diproses
  berhasil
  gagal

  @@map("status_refund")
}

enum StatusPesanan {
  menunggu_pembayaran
  menunggu_verifikasi
  terkonfirmasi
  pengajuan_pembatalan
  ditolak
  kedaluwarsa
  dibatalkan
  selesai

  @@map("status_pesanan")
}

model JenisOlahraga {
  id       Int       @id @default(autoincrement())
  nama     String    @unique
  lapangan Lapangan[]

  @@map("jenis_olahraga")
}

model Lapangan {
  id              Int            @id @default(autoincrement())
  jenisOlahragaId Int            @map("jenis_olahraga_id")
  nama            String
  deskripsi       String?
  alamat          String?
  latitude        Decimal?       @db.Decimal(9, 6)
  longitude       Decimal?       @db.Decimal(9, 6)
  aktif           Boolean        @default(true)
  jenisOlahraga   JenisOlahraga  @relation(fields: [jenisOlahragaId], references: [id])
  foto            FotoLapangan[]
  fasilitas       LapanganFasilitas[]
  jamOperasional  JamOperasional[]
  tarif           Tarif[]
  blokir          BlokirJadwal[]
  pesanan         Pesanan[]
  slot            SlotPesanan[]

  @@index([jenisOlahragaId])
  @@map("lapangan")
}

// Daftar induk fasilitas + relasi banyak-ke-banyak ke lapangan (FR-ADM-02).
model Fasilitas {
  id       Int                 @id @default(autoincrement())
  nama     String              @unique
  lapangan LapanganFasilitas[]

  @@map("fasilitas")
}

model LapanganFasilitas {
  lapanganId  Int       @map("lapangan_id")
  fasilitasId Int       @map("fasilitas_id")
  lapangan    Lapangan  @relation(fields: [lapanganId], references: [id])
  fasilitas   Fasilitas @relation(fields: [fasilitasId], references: [id])

  @@id([lapanganId, fasilitasId])
  @@index([fasilitasId])
  @@map("lapangan_fasilitas")
}

model FotoLapangan {
  id         Int      @id @default(autoincrement())
  lapanganId Int      @map("lapangan_id")
  berkas     String // kunci objek di storage
  urutan     Int      @default(0)
  fotoUtama  Boolean  @default(false) @map("foto_utama")
  lapangan   Lapangan @relation(fields: [lapanganId], references: [id])

  @@index([lapanganId])
  @@map("foto_lapangan")
}

model JamOperasional {
  id         Int      @id @default(autoincrement())
  lapanganId Int      @map("lapangan_id")
  hari       Int // ISO 1-7, Senin=1
  jamBuka    Int      @map("jam_buka")
  jamTutup   Int      @map("jam_tutup")
  buka       Boolean  @default(true)
  lapangan   Lapangan @relation(fields: [lapanganId], references: [id])

  @@unique([lapanganId, hari])
  @@map("jam_operasional")
}

model Tarif {
  id          Int      @id @default(autoincrement())
  lapanganId  Int      @map("lapangan_id")
  tipeHari    TipeHari @map("tipe_hari")
  jamMulai    Int      @map("jam_mulai")
  jamSelesai  Int      @map("jam_selesai")
  hargaPerJam Int      @map("harga_per_jam")
  lapangan    Lapangan @relation(fields: [lapanganId], references: [id])

  @@index([lapanganId])
  @@map("tarif")
}

model BlokirJadwal {
  id             Int      @id @default(autoincrement())
  lapanganId     Int      @map("lapangan_id")
  tanggalMulai   DateTime @map("tanggal_mulai") @db.Date
  tanggalSelesai DateTime @map("tanggal_selesai") @db.Date
  jamMulai       Int?     @map("jam_mulai") // kosong = sehari penuh
  jamSelesai     Int?     @map("jam_selesai")
  alasan         String
  dibuatPada     DateTime @default(now()) @map("dibuat_pada")
  dibuatOleh     Int?     @map("dibuat_oleh")
  lapangan       Lapangan @relation(fields: [lapanganId], references: [id])
  admin          Pengguna? @relation("BlokirDibuatOleh", fields: [dibuatOleh], references: [id])

  @@index([lapanganId, tanggalMulai, tanggalSelesai])
  @@map("blokir_jadwal")
}

model Pengguna {
  id                      Int           @id @default(autoincrement())
  nama                    String
  email                   String        @unique
  kataSandi               String        @map("kata_sandi") // hash
  nomorKontak             String        @map("nomor_kontak")
  peran                   PeranPengguna @default(penyewa)
  emailTerverifikasiPada  DateTime?     @map("email_terverifikasi_pada")
  dinonaktifkanPada       DateTime?     @map("dinonaktifkan_pada")
  dibuatPada              DateTime      @default(now()) @map("dibuat_pada")
  pesanan                 Pesanan[]
  sesi                    Sesi[]
  token                   TokenAkun[]
  blokirDibuat            BlokirJadwal[] @relation("BlokirDibuatOleh")

  @@map("pengguna")
}

model Pesanan {
  id              Int           @id @default(autoincrement())
  kodePesanan     String        @unique @map("kode_pesanan")
  penggunaId      Int           @map("pengguna_id")
  lapanganId      Int           @map("lapangan_id")
  tanggalMain     DateTime      @map("tanggal_main") @db.Date
  jamMulai        Int           @map("jam_mulai")
  jamSelesai      Int           @map("jam_selesai")
  jumlahJam       Int           @map("jumlah_jam")
  totalHarga      Int           @map("total_harga")
  status          StatusPesanan @default(menunggu_pembayaran)
  batasBayarPada  DateTime      @map("batas_bayar_pada")
  alasanPenolakan String?       @map("alasan_penolakan")
  dibuatPada      DateTime      @default(now()) @map("dibuat_pada")
  pengguna        Pengguna      @relation(fields: [penggunaId], references: [id])
  lapangan        Lapangan      @relation(fields: [lapanganId], references: [id])
  slot            SlotPesanan[]
  pembayaran      Pembayaran?
  pembayaranGateway PembayaranGateway[]
  refund          Refund[]
  riwayat         RiwayatStatus[]
  pengajuanPembatalan PengajuanPembatalan?

  @@index([penggunaId, dibuatPada])
  @@index([status, batasBayarPada])
  @@index([tanggalMain])
  @@map("pesanan")
}

model SlotPesanan {
  id          Int      @id @default(autoincrement())
  pesananId   Int      @map("pesanan_id")
  lapanganId  Int      @map("lapangan_id")
  tanggal     DateTime @db.Date
  jam         Int // jam mulai 6-23
  hargaPerJam Int      @map("harga_per_jam")
  aktif       Boolean  @default(true)
  pesanan     Pesanan  @relation(fields: [pesananId], references: [id])
  lapangan    Lapangan @relation(fields: [lapanganId], references: [id])

  @@index([lapanganId, tanggal])
  @@map("slot_pesanan")
}

// Sesi login. Cookie berisi token mentah; yang disimpan hanya hash-nya. Baris kedaluwarsa dibersihkan worker (menyusul).
model Sesi {
  id              Int      @id @default(autoincrement())
  penggunaId      Int      @map("pengguna_id")
  tokenHash       String   @unique @map("token_hash")
  kedaluwarsaPada DateTime @map("kedaluwarsa_pada")
  dibuatPada      DateTime @default(now()) @map("dibuat_pada")
  pengguna        Pengguna @relation(fields: [penggunaId], references: [id], onDelete: Cascade)

  @@index([penggunaId])
  @@index([kedaluwarsaPada])
  @@map("sesi")
}

// Token sekali pakai untuk verifikasi email (dan reset kata sandi nanti).
model TokenAkun {
  id              Int        @id @default(autoincrement())
  penggunaId      Int        @map("pengguna_id")
  jenis           JenisToken
  tokenHash       String     @unique @map("token_hash")
  kedaluwarsaPada DateTime   @map("kedaluwarsa_pada")
  digunakanPada   DateTime?  @map("digunakan_pada")
  pengguna        Pengguna   @relation(fields: [penggunaId], references: [id], onDelete: Cascade)

  @@index([penggunaId, jenis])
  @@map("token_akun")
}

// Bukti transfer: satu per pesanan (bukti ditolak final, PRD BR-11). Berkas asli ada di storage privat; di sini hanya kunci objeknya.
model Pembayaran {
  id               Int              @id @default(autoincrement())
  pesananId        Int              @unique @map("pesanan_id")
  berkasBukti      String           @map("berkas_bukti")
  tipeBerkas       String           @map("tipe_berkas")
  ukuranBerkas     Int              @map("ukuran_berkas")
  diunggahPada     DateTime         @map("diunggah_pada")
  statusVerifikasi StatusVerifikasi @default(menunggu) @map("status_verifikasi")
  diverifikasiOleh Int?             @map("diverifikasi_oleh")
  diverifikasiPada DateTime?        @map("diverifikasi_pada")
  pesanan          Pesanan          @relation(fields: [pesananId], references: [id])

  @@map("pembayaran")
}

// Satu baris per percobaan transaksi payment gateway. `order_id` unik milik provider.
// Pesanan boleh punya beberapa percobaan (mis. kedaluwarsa lalu bayar ulang), tetapi hanya
// satu yang boleh berstatus `dibayar`.
model PembayaranGateway {
  id             Int                    @id @default(autoincrement())
  pesananId      Int                    @map("pesanan_id")
  provider       String                 @default("xendit")
  orderId        String                 @unique @map("order_id")
  providerRef    String?                @map("provider_ref") // invoice id Xendit; dipakai refund & sinkron
  metode         String?
  jumlah         Int
  status         StatusPembayaranGateway @default(pending)
  token          String?
  redirectUrl    String?                @map("redirect_url")
  kedaluwarsaPada DateTime?             @map("kedaluwarsa_pada")
  dibayarPada    DateTime?              @map("dibayar_pada")
  perluTinjau    Boolean                @default(false) @map("perlu_tinjau")
  alasanTinjau   String?                @map("alasan_tinjau")
  dibuatPada     DateTime               @default(now()) @map("dibuat_pada")
  pesanan        Pesanan                @relation(fields: [pesananId], references: [id])
  refund         Refund[]

  @@index([pesananId])
  @@index([status])
  @@index([providerRef])
  @@map("pembayaran_gateway")
}

// Notifikasi mentah dari provider. `event_key` unik = kunci idempotensi.
model GatewayEvent {
  id           Int      @id @default(autoincrement())
  provider     String   @default("xendit")
  eventKey     String   @unique @map("event_key")
  orderId      String   @map("order_id")
  tipe         String
  payload      Json
  diterimaPada DateTime @default(now()) @map("diterima_pada")

  @@index([orderId])
  @@map("gateway_event")
}

// Refund terpisah dari status pesanan: pesanan bisa sudah Dibatalkan sementara refund
// masih diproses/gagal dan diselesaikan manual oleh admin.
model Refund {
  id                  Int          @id @default(autoincrement())
  pesananId           Int          @map("pesanan_id")
  pembayaranGatewayId Int?         @map("pembayaran_gateway_id")
  nominal             Int
  alasan              String
  cara                String // "gateway" | "manual"
  status              StatusRefund @default(menunggu)
  referenceGateway    String?      @map("reference_gateway")
  catatan             String?
  diputuskanOleh      Int?         @map("diputuskan_oleh")
  diputuskanPada      DateTime?    @map("diputuskan_pada")
  selesaiPada         DateTime?    @map("selesai_pada")
  pesanan             Pesanan      @relation(fields: [pesananId], references: [id])
  pembayaranGateway   PembayaranGateway? @relation(fields: [pembayaranGatewayId], references: [id])

  @@index([pesananId])
  @@index([status])
  @@map("refund")
}

// Pengajuan pembatalan pesanan Terkonfirmasi (FR-CAN-02/03). Satu per pesanan: UNIQUE(pesanan_id).
// Slot tetap aktif sampai admin memutuskan; keputusan mencatat catatan, nominal refund, dan pemutus.
model PengajuanPembatalan {
  id             Int             @id @default(autoincrement())
  pesananId      Int             @unique @map("pesanan_id")
  namaPemesan    String          @map("nama_pemesan")
  kontak         String
  alasan         String
  namaBank       String          @map("nama_bank")
  nomorRekening  String          @map("nomor_rekening")
  atasNama       String          @map("atas_nama")
  diajukanPada   DateTime        @map("diajukan_pada")
  status         StatusPengajuan @default(menunggu)
  catatanAdmin   String?         @map("catatan_admin")
  nominalRefund  Int?            @map("nominal_refund")
  diputuskanOleh Int?            @map("diputuskan_oleh")
  diputuskanPada DateTime?       @map("diputuskan_pada")
  pesanan        Pesanan         @relation(fields: [pesananId], references: [id])

  @@map("pengajuan_pembatalan")
}

model RiwayatStatus {
  id         Int            @id @default(autoincrement())
  pesananId  Int            @map("pesanan_id")
  statusLama StatusPesanan? @map("status_lama")
  statusBaru StatusPesanan  @map("status_baru")
  diubahOleh Int?           @map("diubah_oleh") // kosong = sistem
  waktu      DateTime
  catatan    String?
  pesanan    Pesanan        @relation(fields: [pesananId], references: [id])

  @@index([pesananId])
  @@map("riwayat_status")
}

// Pasangan kunci-nilai jsonb (bentuk fieldgo di Supabase): rekening_bank, rekening_nomor,
// rekening_nama, batas_bayar_jam, batas_pembatalan_hari (PRD Bagian 5/7).
model Pengaturan {
  kunci String @id
  nilai Json

  @@map("pengaturan")
}
